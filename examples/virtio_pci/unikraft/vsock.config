CONFIG_PLAT_CARRELS=y
CONFIG_ARCH_ARM_64=y
CONFIG_UKPLAT_CPU_MAXCOUNT=1
CONFIG_LIBUKBOOT_MAINTHREAD=y
CONFIG_LIBUKBOOT_MAINTHREAD_NOHALT=y

CONFIG_LIBUKCONSOLE=y
# CONFIG_LIBUKPRINT_PRINT_TIME is not set
CONFIG_LIBSDDFSERIAL=y
CONFIG_LIBSDDFSERIAL_EARLY_CONSOLE=y
CONFIG_LIBPOSIX_TTY=y
CONFIG_LIBPOSIX_TTY_SERIAL=y
CONFIG_LIBPOSIX_TTY_STDIN_SERIAL=y
CONFIG_LIBPOSIX_TTY_STDOUT_SERIAL=y

CONFIG_LIBUKRANDOM=y
# CONFIG_LIBUKRANDOM_CMDLINE_SEED is not set
# CONFIG_LIBUKRANDOM_DTB_SEED is not set
# CONFIG_LIBUKRANDOM_RESEED is not set

CONFIG_LIBPOSIX_SOCKET=y
CONFIG_LIBVSOCK=y
