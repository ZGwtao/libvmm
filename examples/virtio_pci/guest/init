#!/bin/busybox sh

mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys

echo "source-built virtio_pci guest"

echo "testing virtio-vsock stream transport"
/bin/vsock-hello || echo "virtio-vsock hello test failed"

for script in /etc/init.d/S99*; do
    test -x "$script" || continue
    "$script" || echo "startup script failed: $script"
done

exec setsid cttyhack /bin/sh
